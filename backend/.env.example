# MQTT broker
MQTT_URL=mqtts://your-broker.hivemq.cloud:8883
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=mqtt_pass
MQTT_TOPIC_EVENTS=home/security/events
MQTT_TOPIC_HEARTBEAT=home/security/heartbeat

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Comma-separated FCM device tokens to alert (temporary; move to Firestore in production)
FCM_TOKENS=

# Push alert threshold (0-100)
ALERT_CONFIDENCE_THRESHOLD=80
